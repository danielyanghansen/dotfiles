# Copy values from this file into .env.local for machine-specific settings.

# Optional Oh My Zsh checkout location used by some plugins.
export ZSH="$HOME/.oh-my-zsh"

# Optional local code roots used by personal aliases.
export WEBKOMCODE="$HOME/code/webkomgit"
export PASSWORD_STORE_DIR="$WEBKOMCODE/password-store"

# Set to 1 to stop zsh from automatically entering tmux on startup.
export DOTFILES_DISABLE_AUTO_TMUX=0
